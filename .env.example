# USJET environment configuration
# =============================================================
# 1) Copy this file to `.env.local` (never commit `.env.local`)
# 2) Paste values from Stripe Dashboard → Developers → API keys
# 3) Restart dev server after changes: `npm run dev`
#
# LIVE vs TEST (Stripe)
# - Use matching pairs: pk_live_… + sk_live_… + LIVE Payment Links
#   OR pk_test_… + sk_test_… + TEST Payment Links — never mix modes.
# - Publishable key (pk_*) is safe in the browser bundle (VITE_*).
# - Secret key (sk_*) is server-only — Vercel Production env, never VITE_*.
# - No Stripe webhook env var is required today; member gate uses
#   POST /api/verify-member with STRIPE_SECRET_KEY (subscription lookup).
#
# Key formats (Stripe Dashboard → Developers → API keys)
# - VITE_STRIPE_PUBLISHABLE_KEY = pk_live_... or pk_test_... (Reveal publishable key)
# - STRIPE_SECRET_KEY             = sk_live_... or sk_test_... (Reveal secret key)
# - Keys starting with mk_ are NOT secret API keys — do not use for STRIPE_SECRET_KEY.
# - Never create VITE_STRIPE_SECRET_KEY — VITE_* is embedded in the client bundle.
#
# VITE_* variables are embedded in the client bundle at build time.
# For Vercel Production, set the same VITE_* names in the dashboard
# (Environment: Production) and redeploy after changes.
# =============================================================

# --- OpenRouter (optional — Hangar AI) ---
# Get a key: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
# VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api
# VITE_OPENROUTER_MODEL=openrouter/auto
# VITE_DEBUG=false

# --- Stripe: TEST mode (local dev / sandbox) ---
# Dashboard: Developers → API keys → Test mode ON
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# VITE_STRIPE_FOUNDER_PAYMENT_LINK=https://buy.stripe.com/test_...
# VITE_STRIPE_PRO_PAYMENT_LINK=https://buy.stripe.com/test_...
# VITE_STRIPE_ENTERPRISE_PAYMENT_LINK=https://buy.stripe.com/test_...

# --- Stripe: LIVE mode (production — Founder activated) ---
# Dashboard: Developers → API keys → Test mode OFF
# Payment Links: Products → each tier → Payment link (Live)
VITE_STRIPE_PUBLISHABLE_KEY=
# Server-only — set in Vercel Production, not in VITE_*:
# STRIPE_SECRET_KEY=

# Tier 1 — USJet Flight Pass ($19.90/mo)
# Statement descriptor: USJET.AI-FLIGHT-PASS
# Product metadata: tier=RECRUIT, access_level=LVL_01
# Optional override — default hard-wired in src/lib/stripePaymentLink.ts:
# https://buy.stripe.com/8x25kDeSG2JB38d39Bdwc02
VITE_STRIPE_FOUNDER_PAYMENT_LINK=

# Tier 2 — Hangar Pro ($49.95/mo)
# Statement descriptor: USJET.AI-HANGAR-PRO
# Product metadata: tier=OPERATOR, access_level=LVL_02
# Optional override — default hard-wired in src/lib/stripePaymentLink.ts:
# https://buy.stripe.com/5kQ8wP11Qbg75gl4dFdwc03
VITE_STRIPE_PRO_PAYMENT_LINK=

# Tier 3 — Enterprise Fleet Commander ($199.99/mo)
# Statement descriptor: USJET.AI-FLEET-CMD
# Product metadata: tier=COMMANDER, access_level=LVL_03_SOVEREIGN, legacy_id=AM_KARIM_SUCCESSION
# Optional override — default hard-wired in src/lib/stripePaymentLink.ts:
# https://buy.stripe.com/cNi6oHcKy4RJ38d11tdwc04
VITE_STRIPE_ENTERPRISE_PAYMENT_LINK=

# --- Stripe LIVE product IDs (server-only — verify-member tier mapping) ---
# Dashboard: Products → open each LIVE product → copy prod_… from the URL.
# Paste each ID into the matching tier slot below. You need all three LIVE
# products (or rely on payment links above for checkout only).
# /api/verify-member reads Product metadata from Stripe when STRIPE_SECRET_KEY
# is live; these env vars are a fallback if dashboard metadata is not set yet.
#
# Founder shared one LIVE product (tier not confirmed in repo — check Dashboard name):
#   https://dashboard.stripe.com/acct_1TVZwBIhpTm6FnAv/products/prod_UVsQfIu4wGJoG6
# Open that URL, read the product name, then assign prod_UVsQfIu4wGJoG6 to exactly
# one of the three vars (Flight Pass vs Hangar Pro vs Enterprise Fleet Commander).
# STRIPE_PRODUCT_FLIGHT_PASS=prod_...    # USJet Flight Pass · $19.90/mo · RECRUIT
# STRIPE_PRODUCT_HANGAR_PRO=prod_...     # Hangar Pro · $49.95/mo · OPERATOR
# STRIPE_PRODUCT_ENTERPRISE=prod_...     # Enterprise Fleet Commander · $199.99/mo · COMMANDER

# Optional: Stripe Payment Element (dev only — static client secret; do not ship to prod)
# VITE_STRIPE_PAYMENT_INTENT_CLIENT_SECRET=pi_..._secret_...

# --- Member portal ---
# Browser (defaults shown; override only if API is hosted elsewhere)
# VITE_MEMBER_VERIFY_URL=/api/verify-member
# VITE_MEMBER_DEMO_ID=cus_usjet_demo
# VITE_PARTNERSHIP_ANALYTICS_URL=/api/partnership-analytics
#
# Founder test clearance (hard-wired in src/lib/memberMasterKey.ts):
#   Member ID: USJET-AMEER
#   Billing email: FOUNDER_TEST_EMAIL constant (iPhone test inbox)
#   Session customerId: founder-test-ameer · tier USJET-PRIME-ACTIVE
# Use either Member ID or email at /member, /hangar, and /intel gates.

# --- USJET business email (NOT hosted by this app — configure at registrar/DNS) ---
# Domain registrar: Porkbun (usjet.ai)
#
# TODAY — Secretary of State, D&B / DUNS, LLC formation (use immediately):
#   ameerkarim100@icloud.com
#
# TARGET @usjet.ai addresses (site mailto links in src/lib/usjetContact.ts):
#   ops@usjet.ai      — public contact
#   founder@usjet.ai  — founder / internal
#   billing@usjet.ai  — optional billing correspondence
#   All forward to ameerkarim100@icloud.com until full hosted mail is needed.
#
# Option A — Porkbun Email Forwarding (free, ~5 min; RECOMMENDED if DNS stays at Porkbun):
#   1. porkbun.com → Log in → Domain Management → usjet.ai
#   2. Click the envelope icon under EMAIL (or Domain → Email Hosting and Forwarding)
#   3. Porkbun Email Forwarding → Create a New Forwarding Address:
#        ops     → ameerkarim100@icloud.com
#        founder → ameerkarim100@icloud.com
#   4. Porkbun sets MX/SPF automatically when nameservers point to Porkbun.
#   5. Test from a different inbox (not iCloud) to avoid a forward loop.
#   Limits: receive-only (replies show iCloud From:); no catch-all; up to 20 forwards/domain.
#   KB: https://kb.porkbun.com/article/10-how-to-set-up-email-forwarding
#
# Option B — Cloudflare Email Routing (free; if site DNS moves to Cloudflare):
#   1. Add usjet.ai to Cloudflare (import zone or change nameservers at Porkbun)
#   2. Email → Email Routing → Enable → verify ameerkarim100@icloud.com
#   3. Custom addresses: ops@, founder@, billing@ → iCloud destination
#   If nameservers STAY at Porkbun, add these at Porkbun → DNS → Current Records
#   (remove conflicting MX/SPF first):
#     MX  @  route1.mx.cloudflare.net  priority 39
#     MX  @  route2.mx.cloudflare.net  priority 26
#     MX  @  route3.mx.cloudflare.net  priority 56
#     TXT @  v=spf1 include:_spf.mx.cloudflare.net ~all
#   Do not run Porkbun forwarding and Cloudflare routing at the same time.
#
# Option C — Porkbun hosted email (~$3/mo/address) or Google Workspace (~$7/user/mo):
#   Real inboxes; send/receive as @usjet.ai. Porkbun MX (if DNS elsewhere):
#     MX  @  fwd1.porkbun.com  priority 10
#     MX  @  fwd2.porkbun.com  priority 20
#     TXT @  v=spf1 include:_spf.porkbun.com ~all
#
# Option D — Zoho Mail free tier (up to 5 users): verify domain at zoho.com, add Zoho MX at Porkbun DNS.
#
# This repo publishes mailto: links only — it does NOT provision or run email hosting.

# =============================================================
# Vercel Production checklist (Project → Settings → Environment Variables)
# Set for Environment: Production. Redeploy after adding or changing values.
# Vercel persists these across deploys — do not prefix server secrets with VITE_.
# =============================================================
#
# Required (client — embedded at build time):
#   VITE_STRIPE_PUBLISHABLE_KEY = pk_live_...
#
# Required (server — /api/verify-member only; never VITE_, never browser):
#   STRIPE_SECRET_KEY = sk_live_...   # Dashboard → Developers → API keys → Secret key
#
# Optional payment link overrides (defaults in src/lib/stripePaymentLink.ts):
#   VITE_STRIPE_FOUNDER_PAYMENT_LINK
#   VITE_STRIPE_PRO_PAYMENT_LINK
#   VITE_STRIPE_ENTERPRISE_PAYMENT_LINK
#
# Optional server product IDs (verify-member tier fallback):
#   STRIPE_PRODUCT_FLIGHT_PASS = prod_...
#   STRIPE_PRODUCT_HANGAR_PRO = prod_...
#   STRIPE_PRODUCT_ENTERPRISE = prod_...
#
# Optional backend:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
