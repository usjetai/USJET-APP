# USJET — copy to `.env.local` (never commit `.env.local`)
# cp .env.local.template .env.local
# Paste LIVE publishable key from Stripe Dashboard, then: npm run dev

# --- OpenRouter (optional — Hangar AI) ---
# VITE_OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# --- Stripe LIVE ---
# Publishable key — safe in .env.local and Vercel (VITE_* is embedded in client bundle)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# Secret key — Vercel Production ONLY (serverless /api/verify-member). Never VITE_* or .env.local.
# Copy from Dashboard → Developers → API keys → Secret key (starts with sk_live_).
# Keys starting with mk_ are NOT secret API keys — do not use for STRIPE_SECRET_KEY.
# STRIPE_SECRET_KEY=sk_live_REPLACE_ME

# Payment links — optional; LIVE defaults are hard-wired in src/lib/stripePaymentLink.ts
# VITE_STRIPE_FOUNDER_PAYMENT_LINK=https://buy.stripe.com/8x25kDeSG2JB38d39Bdwc02
# VITE_STRIPE_PRO_PAYMENT_LINK=https://buy.stripe.com/5kQ8wP11Qbg75gl4dFdwc03
# VITE_STRIPE_ENTERPRISE_PAYMENT_LINK=https://buy.stripe.com/cNi6oHcKy4RJ38d11tdwc04

# Server-only LIVE product IDs — Vercel (verify-member tier mapping fallback)
# STRIPE_PRODUCT_FLIGHT_PASS=prod_REPLACE_FLIGHT_PASS
# STRIPE_PRODUCT_HANGAR_PRO=prod_REPLACE_HANGAR_PRO
# STRIPE_PRODUCT_ENTERPRISE=prod_REPLACE_ENTERPRISE

# --- Member portal (defaults — override only if API hosted elsewhere) ---
# VITE_MEMBER_VERIFY_URL=/api/verify-member
# VITE_MEMBER_DEMO_ID=cus_usjet_demo
# VITE_PARTNERSHIP_ANALYTICS_URL=/api/partnership-analytics
# VITE_PARTNERSHIP_APPLICATIONS_URL=/api/partnership-applications
# PARTNERSHIP_APPLICATIONS_TABLE=partnership_applications

# --- Optional: Supabase (partnership analytics backend) ---
# SUPABASE_URL=https://REPLACE_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVICE_ROLE_KEY

# =============================================================
# Vercel Production checklist (Project → Settings → Environment Variables)
# Environment: Production · redeploy after changes · keys persist across deploys
# =============================================================
#
# VITE_STRIPE_PUBLISHABLE_KEY = pk_live_...     (client / build-time)
# STRIPE_SECRET_KEY             = sk_live_...     (server only — NOT VITE_, NOT mk_)
# VITE_STRIPE_FOUNDER_PAYMENT_LINK              (optional override)
# VITE_STRIPE_PRO_PAYMENT_LINK                  (optional override)
# VITE_STRIPE_ENTERPRISE_PAYMENT_LINK           (optional override)
# STRIPE_PRODUCT_FLIGHT_PASS    = prod_...        (optional server fallback)
# STRIPE_PRODUCT_HANGAR_PRO     = prod_...        (optional server fallback)
# STRIPE_PRODUCT_ENTERPRISE     = prod_...        (optional server fallback)
