# Environment configuration for local development
# -------------------------------------------------
# 1) Get an API key at: https://openrouter.ai/keys
# 2) Copy this file to `.env.local`
# 3) Paste your key into VITE_OPENROUTER_API_KEY below
# 4) Restart the dev server after changes: `npm run dev`
#
# IMPORTANT
# - Any variable prefixed with VITE_ is embedded into the browser bundle.
#   Do NOT use production secrets in VITE_* variables.
# - For production, call OpenRouter from your own server (do not expose keys).
#
# Required
VITE_OPENROUTER_API_KEY=
# Optional: Point to a specific API base (usually leave default)
# VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api

# Optional: Model defaults (your app may override at runtime)
# VITE_OPENROUTER_MODEL=openrouter/auto

# Optional: Enable verbose logging during development (true|false)
# VITE_DEBUG=false

# Example .env.local (uncomment and set in your local copy only)
# VITE_OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_DEBUG=true

