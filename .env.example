# USJET environment configuration
# =============================================================
# 1) Copy this file to `.env.local` (never commit `.env.local`)
# 2) Paste values from Stripe Dashboard → Developers → API keys
# 3) Restart dev server after changes: `npm run dev`
#
# LIVE vs TEST (Stripe)
# - Use matching pairs: pk_live_… + sk_live_… + LIVE Payment Links
#   OR pk_test_… + sk_test_… + TEST Payment Links — never mix modes.
# - Publishable key (pk_*) is safe in the browser bundle (VITE_*).
# - Secret key (sk_*) is server-only — Vercel Production env, never VITE_*.
# - No Stripe webhook env var is required today; member gate uses
#   POST /api/verify-member with STRIPE_SECRET_KEY (subscription lookup).
#
# Key formats (Stripe Dashboard → Developers → API keys)
# - VITE_STRIPE_PUBLISHABLE_KEY = pk_live_... or pk_test_... (Reveal publishable key)
# - STRIPE_SECRET_KEY             = sk_live_... or sk_test_... (Reveal secret key)
# - Keys starting with mk_ are NOT secret API keys — do not use for STRIPE_SECRET_KEY.
# - Never create VITE_STRIPE_SECRET_KEY — VITE_* is embedded in the client bundle.
#
# VITE_* variables are embedded in the client bundle at build time.
# For Vercel Production, set the same VITE_* names in the dashboard
# (Environment: Production) and redeploy after changes.
# =============================================================

# --- Gemini for Origin (Google Cloud project usjet-ai) ---
# Keep /origin as the USJET page. Brain = Gemini on your GCP project.
#
# EASIEST (matches Cloud Console Welcome → "Create Gemini API key"):
#   1) Open https://console.cloud.google.com/welcome?project=usjet-ai
#   2) Click "Create Gemini API key" → copy the key
#   3) Paste into Vercel Production as GEMINI_API_KEY (never VITE_*) → Redeploy
GEMINI_API_KEY=
# Optional model override for API-key path (default gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_CLOUD_PROJECT=usjet-ai
#
# OPTIONAL advanced: Vertex AI service account (Startup credits / Vertex User role)
VERTEX_AI_PROJECT=usjet-ai
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash-001
# Raw service account JSON (also used by npm run seo:ping-indexing). Never use VITE_*.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- OpenRouter (Origin Aura fallback + Hired HUD bay chat) ---
# Get a key: https://openrouter.ai/keys
# Used when Vertex is not configured, or Vertex call fails.
OPENROUTER_API_KEY=
# Local dev fallback (embedded in client bundle at build time):
VITE_OPENROUTER_API_KEY=

# --- Origin Realtime S2S (TalkingHead + HeadAudio) ---
# Server-only OpenAI key — powers /api/origin-realtime-call (WebRTC SDP proxy).
# Never put this in VITE_*. Dashboard: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model / voice overrides (defaults: gpt-realtime-mini / marin)
# ORIGIN_REALTIME_MODEL=gpt-realtime-mini
# VITE_ORIGIN_REALTIME_MODEL=gpt-realtime-mini
# VITE_ORIGIN_REALTIME_VOICE=marin
# Custom HF / load-balancer WebSocket (PCM16 append protocol — preferred when set)
# ORIGIN_S2S_WS_URL=wss://your-s2s-host/v1/realtime
# Optional TalkingHead GLB with Oculus visemes (default: official Origin character video)
# VITE_ORIGIN_AVATAR_URL=/origin/origin-avatar.glb
# VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api
# VITE_OPENROUTER_MODEL=openrouter/auto
# VITE_DEBUG=false

# --- Web analytics (traffic + conversion measurement) ---
# Google Analytics 4 Measurement ID. Create a GA4 property at
# https://analytics.google.com → Admin → Data streams → Web → copy the "G-XXXX" ID.
# Live USJET property default is also baked into src/lib/analytics.ts.
# Honors Do-Not-Track / Global Privacy Control. Tracks pageviews, UTM/referrer
# attribution (Product Hunt, TikTok, Reddit, etc.), and begin_checkout events.
VITE_GA4_MEASUREMENT_ID=G-ZTRGGZ4R0P

# --- Stripe: TEST mode (local dev / sandbox) ---
# Dashboard: Developers → API keys → Test mode ON
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# VITE_STRIPE_FOUNDER_PAYMENT_LINK=https://buy.stripe.com/test_...
# VITE_STRIPE_PRO_PAYMENT_LINK=https://buy.stripe.com/test_...
# VITE_STRIPE_ENTERPRISE_PAYMENT_LINK=https://buy.stripe.com/test_...

# --- Stripe statement descriptors (Dashboard setup) ---
# Settings → Business → Public details → Statement descriptors
#
# 1) Static statement descriptor (5–22 chars — must match business / usjet.ai):
#    USJET LLC PASSPORT
#
# 2) Shortened descriptor / PREFIX for card charges (2–10 chars — NOT a placeholder):
#    USJET.AI
#    (Delete GRAILED.CO or any sample text Stripe prefilled.)
#
# 3) Per-product CARD SUFFIX (Payment Link or Product → Statement descriptor suffix):
#    Flight Pass ($19.90/mo)     → FLIGHT PASS     → customer sees: USJET.AI* FLIGHT PASS
#    Hangar Pro ($49.95/mo)      → HANGAR PRO      → USJET.AI* HANGAR PRO
#    Enterprise ($199.99/mo)     → FLEET CMD       → USJET.AI* FLEET CMD
#    Fleet Manual ($2,500)       → MANUAL 2.5K     → USJET.AI* MANUAL 2.5K
#    Code Kit ($499)             → CODE KIT        → USJET.AI* CODE KIT
#    Sovereign Protocol ($100K)  → 100K VAULT      → USJET.AI* 100K VAULT
#
# Card rule: prefix + " * " + suffix ≤ 22 characters total.
# Do NOT set statement_descriptor on card PaymentIntents — use statement_descriptor_suffix only.
# Canonical source: src/data/stripeStatementDescriptors.ts
#
# --- Stripe: LIVE mode (production — Founder activated) ---
# Dashboard: Developers → API keys → Test mode OFF
# Payment Links: Products → each tier → Payment link (Live)
VITE_STRIPE_PUBLISHABLE_KEY=
# Server-only — set in Vercel Production, not in VITE_*:
# STRIPE_SECRET_KEY=

# Gamer-Founder Kit — $99 one-time (Gamer-AI portal /gaming)
# Product metadata: tier=GAMER, access_level=LVL_GAMER_FOUNDER
VITE_STRIPE_GAMER_FOUNDER_KIT_PAYMENT_LINK=

# Tier 1 — USJet Flight Pass ($19.90/mo)
# Card statement: USJET.AI* FLIGHT PASS (suffix: FLIGHT PASS)
# Product metadata: tier=RECRUIT, access_level=LVL_01
# Unlocks Member Portal, full Hangar tabs, and fleet runway.
# Optional override — default hard-wired in src/lib/stripePaymentLink.ts:
# https://buy.stripe.com/eVq7sLdOC0Bt9wBfWndwc0e
VITE_STRIPE_FOUNDER_PAYMENT_LINK=

# Tier 2 — Hangar Pro ($49.95/mo)
# Card statement: USJET.AI* HANGAR PRO (suffix: HANGAR PRO)
# Product metadata: tier=OPERATOR, access_level=LVL_02
# Optional override — default hard-wired in src/lib/stripePaymentLink.ts:
# https://buy.stripe.com/5kQ8wP11Qbg75gl4dFdwc03
VITE_STRIPE_PRO_PAYMENT_LINK=

# Tier 3 — Enterprise Fleet Commander ($199.99/mo)
# Card statement: USJET.AI* FLEET CMD (suffix: FLEET CMD)
# Product metadata: tier=COMMANDER, access_level=LVL_03_SOVEREIGN, legacy_id=AM_KARIM_SUCCESSION
# Optional override — default hard-wired in src/lib/stripePaymentLink.ts:
# https://buy.stripe.com/cNi6oHcKy4RJ38d11tdwc04
VITE_STRIPE_ENTERPRISE_PAYMENT_LINK=

# Fleet Manual Professional — $2,500 one-time (optional override)
# Default hard-wired in src/lib/stripePaymentLink.ts:
# https://buy.stripe.com/14AaEX7qefwn8sxh0rdwc06
VITE_STRIPE_FLEET_MANUAL_PAYMENT_LINK=

# USJET Code Kit — $499 one-time (Stripe product: USJET Code Kit - $499.00)
# Paste Payment Link after creating in Stripe Dashboard:
VITE_STRIPE_CODE_KIT_PAYMENT_LINK=

# Sovereign Fleet Blueprint — $100,000 one-time (optional override)
# Default hard-wired in src/lib/stripePaymentLink.ts:
# https://buy.stripe.com/bJeeVd39Y2JBaAF9xZdwc05
VITE_STRIPE_100K_PAYMENT_LINK=

# --- Stripe LIVE product IDs (server-only — verify-member tier mapping) ---
# Dashboard: Products → open each LIVE product → copy prod_… from the URL.
# Paste each ID into the matching tier slot below. You need all three LIVE
# products (or rely on payment links above for checkout only).
# /api/verify-member reads Product metadata from Stripe when STRIPE_SECRET_KEY
# is live; these env vars are a fallback if dashboard metadata is not set yet.
#
# Founder shared one LIVE product (tier not confirmed in repo — check Dashboard name):
#   https://dashboard.stripe.com/acct_1TVZwBIhpTm6FnAv/products/prod_UVsQfIu4wGJoG6
# Open that URL, read the product name, then assign prod_UVsQfIu4wGJoG6 to exactly
# one of the three vars (Flight Pass vs Hangar Pro vs Enterprise Fleet Commander).
# STRIPE_PRODUCT_FLIGHT_PASS=prod_...    # USJet Flight Pass · $19.90/mo · RECRUIT
# STRIPE_PRODUCT_HANGAR_PRO=prod_...     # Hangar Pro · $49.95/mo · OPERATOR
# STRIPE_PRODUCT_ENTERPRISE=prod_...     # Enterprise Fleet Commander · $199.99/mo · COMMANDER

# Wefunder Form C live campaign (community round — $50k goal)
# VITE_WEFUNDER_RESERVATION_URL=https://wefunder.com/usjet.llc
# Until set, blog CTA routes to /b2b priority waitlist.

# Optional: Stripe Payment Element (dev only — static client secret; do not ship to prod)
# VITE_STRIPE_PAYMENT_INTENT_CLIENT_SECRET=pi_..._secret_...

