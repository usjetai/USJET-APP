# Environment configuration for local development
# -------------------------------------------------
# 1) Get an API key at: https://openrouter.ai/keys
# 2) Copy this file to `.env.local`
# 3) Paste your key into VITE_OPENROUTER_API_KEY below
# 4) Restart the dev server after changes: `npm run dev`
#
# IMPORTANT
# - Any variable prefixed with VITE_ is embedded into the browser bundle.
#   Do NOT use production secrets in VITE_* variables.
# - For production, call OpenRouter from your own server (do not expose keys).
#
# Required
VITE_OPENROUTER_API_KEY=
# Optional: Point to a specific API base (usually leave default)
# VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api

# Optional: Model defaults (your app may override at runtime)
# VITE_OPENROUTER_MODEL=openrouter/auto

# Optional: Enable verbose logging during development (true|false)
# VITE_DEBUG=false

# Stripe (browser-safe publishable key only; client secrets must come from your server in production)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_STRIPE_PAYMENT_INTENT_CLIENT_SECRET=pi_..._secret_...
# VITE_STRIPE_FOUNDER_PAYMENT_LINK=https://buy.stripe.com/...
# Hangar Pro ($49.95/mo) — statement descriptor: USJET.AI-HANGAR-PRO
# Product metadata: Role=PRIME-OPERATOR, Access=FULL-FLEET-SYNC, Tier=FOUNDER-LEVEL
# VITE_STRIPE_PRO_PAYMENT_LINK=https://buy.stripe.com/...
# VITE_STRIPE_ENTERPRISE_PAYMENT_LINK=https://buy.stripe.com/...
#
# Member portal (server-only — set in Vercel, NOT VITE_*)
# STRIPE_SECRET_KEY=sk_live_...
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
#
# Member portal (browser)
# VITE_MEMBER_VERIFY_URL=/api/verify-member
# VITE_MEMBER_DEMO_ID=cus_usjet_demo
# VITE_PARTNERSHIP_ANALYTICS_URL=/api/partnership-analytics

# Example .env.local (uncomment and set in your local copy only)
# VITE_OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_DEBUG=true

