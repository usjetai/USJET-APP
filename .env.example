# USJET environment configuration
# =============================================================
# 1) Copy this file to `.env.local` (never commit `.env.local`)
# 2) Paste values from Stripe Dashboard → Developers → API keys
# 3) Restart dev server after changes: `npm run dev`
#
# LIVE vs TEST (Stripe)
# - Use matching pairs: pk_live_… + sk_live_… + LIVE Payment Links
#   OR pk_test_… + sk_test_… + TEST Payment Links — never mix modes.
# - Publishable key (pk_*) is safe in the browser bundle (VITE_*).
# - Secret key (sk_*) is server-only — Vercel Production env, never VITE_*.
# - No Stripe webhook env var is required today; member gate uses
#   POST /api/verify-member with STRIPE_SECRET_KEY (subscription lookup).
#
# VITE_* variables are embedded in the client bundle at build time.
# For Vercel Production, set the same VITE_* names in the dashboard
# (Environment: Production) and redeploy after changes.
# =============================================================

# --- OpenRouter (optional — Hangar AI) ---
# Get a key: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
# VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api
# VITE_OPENROUTER_MODEL=openrouter/auto
# VITE_DEBUG=false

# --- Stripe: TEST mode (local dev / sandbox) ---
# Dashboard: Developers → API keys → Test mode ON
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# VITE_STRIPE_FOUNDER_PAYMENT_LINK=https://buy.stripe.com/test_...
# VITE_STRIPE_PRO_PAYMENT_LINK=https://buy.stripe.com/test_...
# VITE_STRIPE_ENTERPRISE_PAYMENT_LINK=https://buy.stripe.com/test_...

# --- Stripe: LIVE mode (production — Founder activated) ---
# Dashboard: Developers → API keys → Test mode OFF
# Payment Links: Products → each tier → Payment link (Live)
VITE_STRIPE_PUBLISHABLE_KEY=
# Server-only — set in Vercel Production, not in VITE_*:
# STRIPE_SECRET_KEY=

# Tier 1 — USJet Flight Pass ($19.95/mo)
# Statement descriptor: USJET.AI-FLIGHT-PASS
# Product metadata: tier=RECRUIT, access_level=LVL_01
VITE_STRIPE_FOUNDER_PAYMENT_LINK=

# Tier 2 — Hangar Pro ($49.95/mo)
# Statement descriptor: USJET.AI-HANGAR-PRO
# Product metadata: tier=OPERATOR, access_level=LVL_02
VITE_STRIPE_PRO_PAYMENT_LINK=

# Tier 3 — Enterprise Fleet Commander ($199.99/mo)
# Statement descriptor: USJET.AI-FLEET-CMD
# Product metadata: tier=COMMANDER, access_level=LVL_03_SOVEREIGN, legacy_id=AM_KARIM_SUCCESSION
VITE_STRIPE_ENTERPRISE_PAYMENT_LINK=

# Optional: Stripe Payment Element (dev only — static client secret; do not ship to prod)
# VITE_STRIPE_PAYMENT_INTENT_CLIENT_SECRET=pi_..._secret_...

# --- Member portal ---
# Browser (defaults shown; override only if API is hosted elsewhere)
# VITE_MEMBER_VERIFY_URL=/api/verify-member
# VITE_MEMBER_DEMO_ID=cus_usjet_demo
# VITE_PARTNERSHIP_ANALYTICS_URL=/api/partnership-analytics

# Server-only (Vercel Production / Preview as needed)
# STRIPE_SECRET_KEY=sk_live_...   # same mode as VITE_STRIPE_PUBLISHABLE_KEY
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
